# Meta WhatsApp Cloud API credentials (never commit real values)
WHATSAPP_VERIFY_TOKEN=make_a_long_random_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_APP_SECRET=your_meta_app_secret

# Protects the message dashboard endpoint
DASHBOARD_API_KEY=make_another_long_random_key

# Set this to your GitHub Pages origin after publishing, e.g.
# CORS_ORIGINS=https://YOUR-USERNAME.github.io
CORS_ORIGINS=*
GRAPH_API_VERSION=v22.0
